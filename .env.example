# Safe Firebase web runtime configuration. Firebase web config values identify
# the project and are designed to be present in browser applications. Never
# put a Firebase Admin SDK service account or private key in these variables.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Server-only intelligence provider configuration.
AI_PROVIDER=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
SEARCH_PROVIDER=
SEARCH_API_KEY=

# Invite-only beta: only these verified email addresses may start
# provider-spending generation runs. Comma or space separated; keep
# BETA_ACCESS_MODE=invite-only. Set to public only for an open release.
# When unset or empty, every generation request is denied (fail closed).
BETA_ACCESS_MODE=invite-only
BETA_ALLOWED_EMAILS=
PORT=4173
