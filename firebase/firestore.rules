rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Durable deletion tombstone: written as the first deletion step and
    // never removable by any client. While it exists, no client - this tab,
    // other tabs or devices, stale offline writes, or an ID token issued
    // before the auth record was removed (tokens stay valid for up to an
    // hour after deletion) - can create or update workspace data again.
    // exists() handles accounts whose workspace doc is absent or deleted.
    function accountTombstoned(userId) {
      return exists(/databases/$(database)/documents/accountTombstones/$(userId));
    }

    match /accountTombstones/{userId} {
      // Minimal non-content marker: schema and deletion timestamp only.
      allow create: if signedInOwner(userId)
        && request.resource.data.keys().hasOnly(['schema', 'deletedAt'])
        && request.resource.data.schema == 1
        && request.resource.data.deletedAt is timestamp;
      allow read, update, delete: if false;
    }

    match /users/{userId} {
      allow read, delete: if signedInOwner(userId);
      allow create, update: if signedInOwner(userId) && !accountTombstoned(userId);

      match /strategies/{strategyId} {
        allow read, delete: if signedInOwner(userId);
        allow create, update: if signedInOwner(userId) && !accountTombstoned(userId);
      }
    }
  }
}
